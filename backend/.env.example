# --- required ---
MONGO_URI=mongodb://127.0.0.1:27017/joblisting
# at least 16 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- recommended ---
PORT=5000
# the URL of your frontend (used for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# --- optional: social login (leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- optional: seed scripts ---
# SEED_PASSWORD=choose-a-demo-password
